DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
ANTHROPIC_API_KEY=sk-ant-api03-...
# W4.5 QA judge — Gemini 2.5 Pro (same as n8n W4.5)
GOOGLE_API_KEY=
# GEMINI_API_KEY=  # alias accepted
APIFY_TOKEN=apify_api_...
# LinkedIn scraper actor — approve permissions once in Apify console
# APIFY_LINKEDIN_ACTOR=harvestapi~linkedin-profile-scraper
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
PORT=3000
# DATABASE_SSL=true
# Production Docker/Supabase: DATABASE_SSL_STRICT=false (default). Strict only if DATABASE_SSL_STRICT=true

# JWT (required) — openssl rand -base64 48
JWT_SECRET=
# Admin token exchange (dogfood / internal tools) — openssl rand -base64 24
JWT_API_KEY=
# JWT_EXPIRES_IN=24h
# JWT_PILOT_EXPIRES_IN=15m
# Behind nginx/Caddy/Cloudflare on Hetzner
TRUST_PROXY=true

