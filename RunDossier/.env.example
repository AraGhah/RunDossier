# DATABASE_SSL=true
# Supabase on Docker/Hetzner: relaxed SSL is default (auto). Force strict: DATABASE_SSL_STRICT=true
# Remove NODE_TLS_REJECT_UNAUTHORIZED — pg uses ssl.rejectUnauthorized instead (see pg-ssl.ts)

