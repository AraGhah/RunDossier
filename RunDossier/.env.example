# =============================================================================
# RunDossier — template de configuration (W1 → W5)
# cp .env.example .env   puis remplir les valeurs
# =============================================================================

# --- Obligatoire (startup + npm run verify) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY=          # alias de GOOGLE_API_KEY
APIFY_TOKEN=
JWT_SECRET=
JWT_API_KEY=

# --- W3 Research : LinkedIn (Apify) + Apollo + podcasts ---
APOLLO_API_KEY=
APOLLO_ENABLED=true
# APIFY_LINKEDIN_ACTOR=harvestapi~linkedin-profile-scraper
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=

# --- W1 Prospect Search : Sales Navigator ---
SEARCH_ENABLED=true
SEARCH_DEFAULT_MAX_RESULTS=50
SEARCH_ENRICH_MAX_PER_RUN=10
# APIFY_SALES_NAV_ACTOR=silentflow~linkedin-sales-navigator-scraper
# Main search — cold email / lead-gen / demand-gen agencies (Email Marketing, Demand Generation, Lead Generation)
APIFY_SALES_NAV_SEARCH_URL=
# Separate consulting search — GTM / outbound / revenue consultants only
APIFY_SALES_NAV_SEARCH_URL_CONSULTING=
LINKEDIN_SALES_NAV_COOKIE=
LINKEDIN_USER_AGENT=

# --- Notifications (Telegram bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=          # set when using POST /api/telegram/webhook
# TELEGRAM_POLLING=true             # local dev only — long polling (not with webhook)
# TELEGRAM_DIGEST_QUIET=true        # skip hourly digest when pipeline idle (default: true)

# --- W5 Delivery — Resend (preferred) or Gmail SMTP ---
RESEND_API_KEY=
DELIVERY_FROM_EMAIL=deliveries@getdossier.co
DELIVERY_REPLY_TO=ara@getdossier.co
# RESEND_SANDBOX_FROM=onboarding@resend.dev
# RESEND_SANDBOX_FALLBACK=true       # retry via Resend sandbox if domain unverified (default: true)
# DELIVERY_TEST_TO=ara@getdossier.co # recipient for npm run delivery:test
# GMAIL_USER=you@gmail.com           # Gmail SMTP fallback + admin copies
# GMAIL_APP_PASSWORD=                # Google App Password (not your login password)
# GMAIL_DELIVERY_TO=you@gmail.com    # receive CSV copies on your Gmail
# DELIVERY_EMAIL_PROVIDER=auto       # auto | resend | gmail
# DELIVERY_CSV_ONLY=false            # never finalize without email unless explicitly true
# DELIVERY_DIR=/tmp/dossier-deliveries

# --- Workflow 10 Dogfood (optionnel) ---
# DOGFOOD_ENABLED=true
# DOGFOOD_WEEKLY_CAP=200
# DOGFOOD_TOP_PERCENT=0.3
# DOGFOOD_SCRAPE_BATCH_SIZE=30
# DOGFOOD_API_TOKEN=
# SMARTLEAD_API_KEY=
# SMARTLEAD_CAMPAIGN_ID=

# --- Serveur ---
PORT=3000
TRUST_PROXY=true
# DATABASE_SSL=true
# DATABASE_SSL_STRICT=false
# CORS_ORIGINS=https://getdossier.co,http://localhost:5173

# --- JWT ---
# JWT_EXPIRES_IN=24h
# JWT_PILOT_EXPIRES_IN=15m

# --- Modèles (codés en dur dans src/config.ts) ---
# W3 research  → claude-haiku-4-5-20251001
# W4 personalize → claude-sonnet-4-6
# W4.5 QA      → gemini-2.5-pro
