{
  "name": "Preframe",
  "version": "1.0.0",
  "description": "Preframe B2B prospect research and personalization pipeline",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "fix-encoding": "powershell -NoProfile -Command \"$utf8 = New-Object System.Text.UTF8Encoding $false; Get-ChildItem -Recurse src -Filter *.ts | ForEach-Object { $b = [IO.File]::ReadAllBytes($_.FullName); if ($b.Length -ge 2 -and $b[1] -eq 0) { [IO.File]::WriteAllText($_.FullName, [IO.File]::ReadAllText($_.FullName, [Text.Encoding]::Unicode), $utf8); Write-Host Fixed $_.Name } }\"",
    "verify": "tsx scripts/verify-pipelines.ts",
    "verify:full": "tsx scripts/run-final-verification.ts",
    "verify:audit": "tsx scripts/run-production-audit.ts",
    "icp:100": "tsx scripts/run-icp-100-batch.ts",
    "verify:security": "tsx scripts/verify-security.ts",
    "ingest": "tsx scripts/ingest-prospects.ts",
    "repair": "tsx scripts/repair-incomplete-personalize.ts",
    "requeue": "tsx scripts/requeue-research.ts",
    "dogfood:migrate": "tsx scripts/apply-dogfood-migration.ts",
    "dogfood:scrape": "tsx scripts/run-dogfood-scrape.ts",
    "dogfood:queue": "tsx scripts/dogfood-review-queue.ts",
    "landing:openers": "tsx scripts/export-landing-openers.ts",
    "pilot:migrate": "tsx scripts/apply-pilot-migration.ts",
    "workflow:migrate": "tsx scripts/apply-workflow-migration.ts",
    "audit:migrate": "tsx scripts/apply-audit-migration.ts",
    "search": "tsx scripts/run-prospect-search.ts",
    "governor:simulate": "tsx scripts/simulate-cost-spike.ts",
    "test": "tsx --test src/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=src/utils/** --test-coverage-include=src/middleware/** src/**/*.test.ts",
    "audit:deps": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "apify-client": "^2.23.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "nodemailer": "^9.0.1",
    "pg": "^8.21.0",
    "pg-boss": "^12.19.1"
  }
}
