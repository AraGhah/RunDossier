# Backend API URL (empty = same origin / Vite dev proxy)
# Production (Cloudflare Pages): set to your Hetzner API, e.g. https://api.getdossier.co
# VITE_API_URL=https://api.getdossier.co

# Cal.com booking (account: cal.com/preframe)
# Default embed: preframe/30min (30 min, your configured hours)
# Organizer booking emails → configure in Cal.com (not here):
#   app.cal.com → Settings → Email: ara@getdossier.co
#   Settings → Notifications: enable New booking / Reschedule / Cancellation
# Optional — separate event types for Zoom vs Teams:
# VITE_CAL_ZOOM_LINK=preframe/30min
# VITE_CAL_TEAMS_LINK=preframe/30min

# Public business phone (E.164 recommended), shown in footer + schema.org ContactPoint
# VITE_CONTACT_PHONE=+14165551234

# Cloudflare Web Analytics — token from the beacon URL (Web Analytics → your site).
# Set on Cloudflare Pages (Production + Preview). Loads via /cloudflare-beacon/* proxy.
# VITE_CF_BEACON_TOKEN=v833ccba57c9e4d2798f2e76cebdd09a11778172276447
