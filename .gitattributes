# Normalize line endings: store LF in the repo, check out native on Windows.
# Fixes the OneDrive/Windows CRLF drift that makes every file look "modified".
* text=auto eol=lf

# Binary assets must never be normalized.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.woff binary
*.woff2 binary
