{
  "name": "Workflow 10 — Dogfood pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "cron-6h",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PREFRAME_URL }}/dogfood/scrape",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "scrape",
      "name": "Dogfood scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Preframe Dogfood Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PREFRAME_URL }}/dogfood/promote",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "promote",
      "name": "Promote top 30%",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Preframe Dogfood Token"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.PREFRAME_URL }}/dogfood/funnel",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "funnel",
      "name": "Log funnel snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Preframe Dogfood Token"
        }
      }
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [
        [
          {
            "node": "Dogfood scrape",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dogfood scrape": {
      "main": [
        [
          {
            "node": "Promote top 30%",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Promote top 30%": {
      "main": [
        [
          {
            "node": "Log funnel snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    {
      "name": "preframe",
      "id": "workflow-10"
    }
  ]
}
